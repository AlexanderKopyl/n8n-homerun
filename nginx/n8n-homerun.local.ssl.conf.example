server {
    listen 443 ssl http2;
    server_name n8n-homerun.local;

    # Replace these two paths with your existing local SSL certificates directory.
    # Do not commit real private keys.
    ssl_certificate /path/to/your/ssl/n8n-homerun.local.pem;
    ssl_certificate_key /path/to/your/ssl/n8n-homerun.local-key.pem;

    add_header X-N8N-Homerun-VHost matched always;

    location / {
        proxy_pass http://127.0.0.1:15678;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
